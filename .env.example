# Port for Express API server
PORT=3001

# Team Passkey for private internal access (default: ax2026)
TEAM_PASSKEY=ax2026

# Optional: Google Apps Script Webhook URL for live cloud sync
# Deploy google-apps-script/Code.gs as a Web App and paste the URL here:
APPS_SCRIPT_URL=

# Optional: Google Cloud Service Account credentials (server-side only, never sent to frontend)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
